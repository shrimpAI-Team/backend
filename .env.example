# Database Configuration (PostgreSQL 16+)
DATABASE_URL="postgresql://admin:password@localhost:5433/shrimp_vision?schema=public"
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=shrimp_vision
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Server & CORS
NODE_ENV=dev
PORT=4000
FRONTEND_URL="http://localhost:5174,http://localhost:5175,http://localhost:5173"

# JWT Authentication
JWT_ACCESS_SECRET="your_jwt_access_secret_key_here"
JWT_ACCESS_TTL="15m"
JWT_CHALLENGE_SECRET="your_jwt_challenge_secret_key_here"
JWT_CHALLENGE_TTL="5m"
REFRESH_TTL_DAYS=30

# OTP & Two-Factor Authentication (2FA)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
TOTP_ISSUER="shrimpAI"

# Mail SMTP (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="no-reply@shrimp.ai"

# OAuth2 Providers
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
FACEBOOK_CALLBACK_URL="http://localhost:4000/auth/facebook/callback"

ZALO_APP_ID="your_zalo_app_id"
ZALO_APP_SECRET="your_zalo_app_secret"
ZALO_CALLBACK_URL="http://localhost:4000/auth/zalo/callback"
