// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

enum Role {
  USER
  ADMIN
}

enum OtpPurpose {
  REGISTER
  LOGIN_2FA
  DISABLE_2FA
  RESET_PASSWORD
}

enum TwoFactorMethod {
  NONE
  EMAIL_OTP
  TOTP
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String?
  name             String?
  avatarUrl        String?
  role             Role            @default(USER)
  emailVerifiedAt  DateTime?
  isActive         Boolean         @default(true)

  twoFactorEnabled Boolean         @default(false)
  twoFactorMethod  TwoFactorMethod @default(NONE)
  totpSecret       String?
  totpPendingSecret String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  otpTokens        OtpToken[]
  sessions         Session[]
  oauthAccounts    OAuthAccount[]
  chatSessions     ChatSession[]
  shrimpAnalyses   ShrimpAnalysis[]
  ponds            Pond[]

  @@index([email])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OtpToken {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, consumedAt])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceId         String
  deviceName       String?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  @@index([userId, revokedAt])
  @@index([deviceId])
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Đoạn chat mới")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          String      // "user" | "assistant" | "system"
  content       String      @db.Text
  createdAt     DateTime    @default(now())

  @@index([chatSessionId, createdAt])
}

model ShrimpAnalysis {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl         String    @db.Text
  originalName     String?
  species          String
  scientificName   String
  confidence       Float
  healthStatus     String?
  sizeEstimate     String?
  commercialGrade  String?
  description      String?   @db.Text
  abnormalDetected Boolean   @default(false)
  alerts           String[]  @default([])
  modelStatus      String?
  processingTime   String?
  imageDimensions  String?
  sizeMetrics      Json?
  colorAnalysis    Json?
  uniformity       Json?
  abnormalities    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  cultureCycles    CultureCycle[]

  @@index([userId, createdAt])
  @@index([species])
}

model Pond {
  id        String         @id @default(uuid())
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime       @default(now())
  cycles    CultureCycle[]

  @@index([ownerId, createdAt])
}

model CultureCycle {
  id           String          @id @default(uuid())
  pondId       String
  pond         Pond            @relation(fields: [pondId], references: [id], onDelete: Cascade)
  // The open cycle holds its pond ID here. Closed cycles release the unique slot.
  activePondId String?         @unique
  species      String
  analysisId   String?
  analysis     ShrimpAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  journals     PondJournal[]

  @@index([pondId, startedAt])
  @@index([analysisId])
}

enum PondJournalKind {
  WATER
  FEED
  CARE
  INCIDENT
}

model PondJournal {
  id           String          @id @default(uuid())
  cycleId      String
  cycle        CultureCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  kind         PondJournalKind
  note         String?         @db.Text
  ph           Float?
  salinity     Float?
  temperature  Float?
  depth        Float?
  feedKg       Float?
  simulated    Boolean         @default(false)
  recordedAt   DateTime        @default(now())

  @@index([cycleId, recordedAt, id])
}
